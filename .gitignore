# Ignore everything in the local workspace by default; whitelist only open-source files
*

!.gitignore
!README.md
!pack-extension.js

!extension-src/
!extension-src/**
extension-src/.DS_Store
extension-src/**/.DS_Store

!server/
server/*
!server/public/
server/public/*
!server/public/index.html
!server/public/images/
server/public/images/*
!server/public/images/cards/
!server/public/images/cards/**
!server/public/images/alliant-step-actions-v2.1.png
!server/public/images/alliant-step-panel-v2.1.png
!server/public/images/alliant-step-result.png
!server/public/images/bofa-step-skip-prefill.png
!server/public/images/chase-pre-itin-form.png
!server/public/images/ext-bofa-v2.1.png
!server/public/images/ext-c1-v2.1.png
!server/public/images/ext-main-v2.1.png
!server/public/images/ext-tg-modal-v2.1.png
!server/public/images/step1-new-to-chase.jpg

.DS_Store
**/.DS_Store
